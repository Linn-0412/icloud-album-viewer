ICLOUD_SHARED_ALBUM_URL="https://www.icloud.com/sharedalbum/ja-jp/#..."
CACHE_TTL_SECONDS=60
ALBUM_VIEWER_ADMIN_EMAIL=admin@example.com
ALBUM_VIEWER_ADMIN_PASSWORD=change-this-password
ALBUM_VIEWER_SESSION_SECRET=use-a-long-random-string
ALBUM_VIEWER_ADMIN_RESET=false
INVITE_TTL_HOURS=72

# Cloudflare Workers cannot use SMTP directly. If you do not own a domain,
# use Google Apps Script + Gmail for automatic invitation emails.
# GOOGLE_MAIL_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# GOOGLE_MAIL_WEBHOOK_SECRET=use-a-long-random-string
# GMAIL_FROM=your@gmail.com
# MAIL_REPLY_TO=your@gmail.com

# Resend requires a verified sending domain for family/member emails.
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="iCloud Album Viewer <album@example.com>"
# MAIL_REPLY_TO=album@example.com

# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4.1-mini
